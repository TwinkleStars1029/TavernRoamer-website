---
import SiteLayout from '../layouts/SiteLayout.astro';
import CloudSky from '../components/CloudSky.astro';

const base = import.meta.env.BASE_URL;
const luggage = [
  { name: '聊天紀錄', detail: '聊過的話，走過的篇章', side: 'left', row: 1, path: 'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z' },
  { name: '角色卡', detail: '陪伴你的角色與模樣', side: 'left', row: 2, path: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2ZM9 9a3 3 0 1 0 6 0 3 3 0 0 0-6 0Zm-1 9v-1a4 4 0 0 1 8 0v1' },
  { name: '玩家人設', detail: '故事裡的你，連同頭像', side: 'left', row: 3, path: 'M8 7a4 4 0 1 0 8 0 4 4 0 0 0-8 0ZM4 21v-2a8 8 0 0 1 16 0v2' },
  { name: '世界書', detail: '這個世界的背景與細節', side: 'right', row: 1, path: 'M12 5v16M3 3h5a4 4 0 0 1 4 2 4 4 0 0 1 4-2h5v16h-5a4 4 0 0 0-4 2 4 4 0 0 0-4-2H3V3Z' },
  { name: '預設提示詞', detail: '為對話選好的設定', side: 'right', row: 2, path: 'M4 7h16M4 17h16M8 4v6M16 14v6' },
  { name: '正則', detail: '熟悉的文字處理規則', side: 'right', row: 3, path: 'm8 5-5 7 5 7m8-14 5 7-5 7m-3-15-2 16' }
];
const benefits = [
  { title: '聊過的，輕輕留存', copy: '每 N 則訊息自動上傳聊天，讓你少一點惦記，多一點專心。', path: 'M20 16.5A5 5 0 0 0 18 7a6 6 0 0 0-11.7 1A4.5 4.5 0 0 0 5 17h3m4 4V11m-4 4 4-4 4 4' },
  { title: '出發前，留下來時的足跡', copy: '更新與還原前，先備份本機內容；備份未完成，就中止對應的覆蓋。', path: 'M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Zm-4-10 3 3 5-6' },
  { title: '故事，由自己好好保管', copy: '存進自己的 Google Drive，也由你決定要帶走與還原哪些素材。', path: 'M4 21V7l8-4 8 4v14M8 21v-7h8v7M2 21h20M9 8h6' }
];
---

<SiteLayout title="讓故事乘著雲，在各處酒館之間漫遊。" description="TavernRoamer 以聊天視窗為中心，將聊天紀錄與搭配的角色卡、人設、世界書、預設和正則備份到自己的 Google Drive，讓故事在各處酒館之間接續。" active="home">
  <div class="home-page">
    <section class="hero home-hero sky-scope" aria-labelledby="home-title">
      <CloudSky variant="full" />
      <div class="wrap hero-copy">
        <div class="eyebrow">TavernRoamer · 雲端漫遊</div>
        <h1 id="home-title">讓故事乘著雲，<br /><em>在各處酒館之間漫遊。</em></h1>
        <p class="lead">以聊天視窗為中心，收好故事與搭配的素材，換個酒館接著聊。</p>
        <div class="button-row">
          <a class="button secondary" href="#story">酒館漫遊介紹<span aria-hidden="true">↓</span></a>
          <a class="button" href={`${base}install/`}>開始安裝 <span aria-hidden="true">→</span></a>
        </div>
        
      </div>
    </section>

    <section class="section" id="story" aria-labelledby="story-title">
      <div class="wrap">
        <div class="section-heading">
          <div class="eyebrow">故事隨行</div>
          <h2 id="story-title">換個地方，<br />還想接著那句未完的話。</h2>
          <p>從家裡到掌心，接續同一扇聊天窗裡的故事。</p>
        </div>
        <div class="grid-2 scenes">
          <article class="home-card scene">
            <div class="scene-art" aria-hidden="true">
              <svg viewBox="0 0 320 160" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle class="scene-wash" cx="160" cy="80" r="70" />
                <circle cx="259" cy="39" r="14" /><path d="M259 16v-5m0 56v-5m23-23h5m-56 0h5m7-16-4-4m36 36 4 4m-4-36 4-4" />
                <rect class="device-fill" x="77" y="29" width="166" height="101" rx="7" /><path d="M77 47h166M142 130v18m36-18v18m-48 0h60" />
                <circle cx="88" cy="38" r="1" /><circle cx="95" cy="38" r="1" /><circle cx="102" cy="38" r="1" />
                <rect class="bubble-fill" x="94" y="63" width="88" height="16" rx="8" /><rect class="bubble-fill" x="141" y="89" width="84" height="16" rx="8" />
                <path d="M31 147h258m-234 0v-22m-7 7 7 6 7-12" />
              </svg>
            </div>
            <div class="scene-copy">
              <div class="tag">在家 · 本機酒館</div>
              <h3>慢慢聊過一個午後。</h3>
              <p>在電腦前，和熟悉的角色，讓故事往前走一點。</p>
            </div>
          </article>
          <article class="home-card scene">
            <div class="scene-art" aria-hidden="true">
              <svg viewBox="0 0 320 160" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle class="scene-wash" cx="160" cy="80" r="70" />
                <path d="M73 25a17 17 0 1 0 20 22 17 17 0 0 1-20-22ZM245 36v10m-5-5h10m-188 58v8m-4-4h8m193-34v6m-3-3h6" />
                <rect class="device-fill" x="120" y="10" width="80" height="140" rx="12" /><path d="M143 18h34M148 140h24" />
                <rect class="bubble-fill" x="132" y="42" width="48" height="18" rx="8" /><rect class="bubble-fill" x="145" y="72" width="43" height="18" rx="8" /><rect class="bubble-fill" x="132" y="102" width="37" height="12" rx="6" />
                <path d="M55 148h210m-181 0v-19m-7 5 7 5 7-11m137 20v-23m-7 8 7 5 7-12" />
              </svg>
            </div>
            <div class="scene-copy">
              <div class="tag">出門 · 雲端酒館</div>
              <h3>打開手機，再聊一會。</h3>
              <p>連上雲端酒館，把剛才的進度，接到下一段對話。</p>
            </div>
          </article>
        </div>
        <div class="packing-thought">
          <p>每次換個環境，卻總得逐一搬好聊天紀錄與搭配的素材，才能坐下來，接著聊。</p>
        </div>
      </div>
    </section>

    <section class="section luggage-section" id="story-luggage" aria-labelledby="luggage-title">
      <div class="wrap">
        <div class="section-heading">
          <div class="eyebrow">故事行囊</div>
          <h2 id="luggage-title">每一扇聊天視窗，<br />都有一份自己的故事行囊。</h2>
          <p>圍繞目前的聊天視窗整理備份，讓故事與搭配的素材，有一個共同的歸處。</p>
        </div>
        <div class="luggage-map">
          <svg class="luggage-threads" viewBox="0 0 1000 360" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <path d="M215 60C340 60 310 180 500 180M215 180H500M215 300C340 300 310 180 500 180M785 60C660 60 690 180 500 180M785 180H500M785 300C660 300 690 180 500 180" />
          </svg>
          <div class="story-window">
            <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>一段未完的故事</span></div>
            <div class="window-content">
              <h3>目前的聊天視窗</h3>
              <p>這段故事與搭配的素材</p>
            </div>
            <div class="window-foot">同一段故事，共同的歸處</div>
          </div>
          <div class="luggage-items">
            {luggage.map(item => (
              <div class:list={['luggage-item', `luggage-item--${item.side}`]} style={`--item-row: ${item.row}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.path} /></svg>
                <div><strong>{item.name}</strong><span>{item.detail}</span></div>
              </div>
            ))}
          </div>
        </div>
        <div class="luggage-caption">
          <p>選好素材，備份到雲端；在另一個酒館取回聊天，再按需還原。</p>
          <a class="text-link" href={`${base}how-to-use/#environment`}>看看行囊裡能收好哪些內容 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-heading">
          <div class="eyebrow">安心漫遊</div>
          <h2 id="features-title">讓漫遊的途中，<br />少一些掛心。</h2>
          <p>把保存的瑣事交給工具，留多一點時間，給還想繼續的故事。</p>
        </div>
        <div class="grid-3 benefit-grid">
          {benefits.map(benefit => (
            <article class="home-card benefit-card">
              <svg class="benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={benefit.path} /></svg>
              <div class="benefit-copy"><h3>{benefit.title}</h3><p>{benefit.copy}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="journey" aria-labelledby="journey-title">
      <div class="wrap">
        <div class="section-heading">
          <div class="eyebrow">漫遊路線</div>
          <h2 id="journey-title">在這座酒館收好，<br />到下一座酒館展開。</h2>
          <p>從這扇聊天窗出發，經過自己的雲端，再到另一座酒館接著聊。</p>
        </div>
        <div class="journey-grid">
          <ol class="journey-stops">
            <li><span class="stop-number" aria-hidden="true">01</span><div><div class="tag">目前的酒館</div><h3>收好這扇窗的行囊</h3><p>上傳聊天，再備份需要的素材；確認沒有待傳資料後，就能出發。</p></div></li>
            <li><span class="stop-number" aria-hidden="true">02</span><div><div class="tag">自己的 Google Drive</div><h3>故事在雲端陪你一起旅行</h3><p>聊天視窗與環境一起收藏，存進自己的 Google Drive。</p></div></li>
            <li><span class="stop-number" aria-hidden="true">03</span><div><div class="tag">另一座酒館</div><h3>展開行囊，接著聊下去</h3><p>建立或更新聊天，再還原需要的環境素材，接著聊下去。</p></div></li>
          </ol>
          <figure class="home-card product-shot">
            <img src={`${base}images/tavernroamer-panel.png`} width="1715" height="1291" alt="TavernRoamer 雲端漫遊面板示意圖，顯示 Google Drive 連線、聊天同步及酒館環境備份功能" loading="lazy" decoding="async" />
            <a class="product-shot-link text-link" href={`${base}interface/`}>認識操作介面 <span aria-hidden="true">→</span></a>
          </figure>
        </div>
        <div class="journey-link"><a class="text-link" href={`${base}how-to-use/`}>跟著完整教學，走過第一次漫遊 <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="section" id="prepare" aria-labelledby="prepare-title">
      <div class="wrap">
        <div class="section-heading">
          <div class="eyebrow">閱讀路線</div>
          <h2 id="prepare-title">初次踏上旅程，<br />跟著路線慢慢出發。</h2>
          <p>先完成安裝，再連上自己的雲端。接著，讓想了解的那份指南，陪你往下走。</p>
        </div>
        <ol class="reading-route" role="list" aria-label="建議閱讀順序">
          <li class="reading-step">
            <span class="stop-number" aria-hidden="true">01</span>
            <div class="reading-content">
              <h3><a class="reading-title-link" href={`${base}install/`}>安裝指南 <span class="reading-arrow" aria-hidden="true">→</span></a></h3>
              <p>安裝酒館助手與 TavernRoamer，為漫遊準備好起點。</p>
            </div>
          </li>
          <li class="reading-step">
            <span class="stop-number" aria-hidden="true">02</span>
            <div class="reading-content">
              <h3><a class="reading-title-link" href={`${base}setup/google-oauth/`}>Google 設定 <span class="reading-arrow" aria-hidden="true">→</span></a></h3>
              <p>完成 Google 授權設定，申請雲端通行證，讓故事找到雲端自在跟隨。</p>
            </div>
          </li>
          <li class="reading-step">
            <span class="stop-number" aria-hidden="true">03</span>
            <div class="reading-content">
              <h3 class="reading-stage-title">接著探索</h3>
              <p>前兩步完成後，選一份指南，從想了解的地方繼續。</p>
              <ul class="reading-guides" role="list" aria-label="依需要選讀">
                <li><a class="reading-guide" href={`${base}how-to-use/`}>
                  <div class="reading-guide-heading"><h4>使用教學</h4><span class="reading-arrow" aria-hidden="true">→</span></div>
                  <p>走過上傳聊天、取回與環境還原的流程。</p>
                </a></li>
                <li><a class="reading-guide" href={`${base}interface/`}>
                  <div class="reading-guide-heading"><h4>面板介紹</h4><span class="reading-arrow" aria-hidden="true">→</span></div>
                  <p>認識狀態與按鈕，找到操作的位置。</p>
                </a></li>
                <li><a class="reading-guide" href={`${base}data-and-permissions/`}>
                  <div class="reading-guide-heading"><h4>資料與權限</h4><span class="reading-arrow" aria-hidden="true">→</span></div>
                  <p>了解資料存放、授權與還原影響。</p>
                </a></li>
              </ul>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section farewell" aria-labelledby="farewell-title">
      <div class="wrap">
        <div class="eyebrow">下一段旅程</div>
        <h2 id="farewell-title">故事在雲端漫遊<br />陪你一起旅行</h2>
        <p class="lead">帶著這扇聊天窗的行囊，<br />到各處酒館都能接續聊天</p>
        <div class="button-row">
          <a class="button" href={`${base}install/`}>開始安裝 <span aria-hidden="true">→</span></a>
          <a class="button" href={`${base}how-to-use/`}> 使用教學 →</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .home-page {
    --home-gap: 24px;
    --home-card-padding: 24px;
    --home-radius: 12px;
    --home-copy-width: 44rem;
    --home-card-title: 20px;
    --home-section-space: 64px;
    overflow-wrap: break-word;
    font-size: 16px;
  }

  .home-page .section {
    position: relative;
    padding-block: var(--home-section-space);
    border-top: 0;
  }

  .home-page .section + .section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: calc(100% - 56px);
    max-width: 1064px;
    height: 1px;
    margin-inline: auto;
    background: var(--line);
    opacity: 0.6;
    pointer-events: none;
  }

  .home-page h1,
  .home-page h2 {
    text-wrap: balance;
  }

  .home-page h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--home-card-title);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .home-page p {
    margin: 0;
    line-height: 1.8;
  }

  .home-page .eyebrow,
  .home-page .tag {
    font: 500 14px/1.6 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .home-page .eyebrow {
    margin-bottom: 12px;
  }

  .home-page .section-heading {
    max-width: var(--home-copy-width);
    margin: 0 0 var(--home-gap);
    text-align: left;
  }

  .home-page .section-heading h2 {
    margin: 0;
    line-height: 1.4;
  }

  .home-page .section-heading p {
    margin-top: 12px;
    font-size: 16px;
  }

  .home-page .text-link {
    font-size: 16px;
    line-height: 1.7;
  }

  .home-page .button {
    min-height: 46px;
    justify-content: center;
    border-radius: 8px;
  }

  .home-card {
    padding: var(--home-card-padding);
    border: 1px solid var(--line);
    border-radius: var(--home-radius);
    background: var(--surface);
    box-shadow: none;
  }

  .home-card p {
    color: var(--muted);
    font-size: 16px;
  }

  .scenes,
  .benefit-grid {
    gap: var(--home-gap);
  }

  /* The opening and closing frame the story; all middle headings share one axis. */
  .home-hero {
    --cloud-bank-h: clamp(160px, 16vw, 220px);
    padding-top: calc(var(--topbar-h) + 56px);
    padding-bottom: var(--cloud-bank-h);
  }

  .hero-copy {
    text-align: center;
  }

  .hero-copy .eyebrow,
  .hero-copy .button-row,
  .farewell .eyebrow,
  .farewell .button-row {
    justify-content: center;
  }

  .hero-copy h1 {
    margin: 20px 0;
    font-size: clamp(32px, 5vw, 60px);
    line-height: 1.45;
  }

  .home-hero .lead {
    max-width: var(--home-copy-width);
    margin-inline: auto;
    font-size: 17px;
    text-wrap: balance;
  }

  .home-page .button-row {
    gap: 16px;
    margin-top: var(--home-gap);
  }

  .home-page .hero-note {
    margin-top: 20px;
    color: var(--muted);
    font-size: 14px;
  }

  /* Shared cards, with smaller artwork when the scenes stack. */
  .scene-art {
    height: 128px;
    margin-bottom: 16px;
    color: var(--accent);
  }

  .scene-art svg {
    width: 100%;
    height: 100%;
  }

  .scene-wash {
    fill: var(--accent-soft);
    stroke: none;
    opacity: 0.65;
  }

  .device-fill {
    fill: var(--surface);
  }

  .bubble-fill {
    fill: var(--surface-2);
    stroke: none;
  }

  .scene h3 {
    margin-top: 8px;
  }

  .scene p,
  .benefit-card p {
    margin-top: 8px;
  }

  .packing-thought {
    max-width: var(--home-copy-width);
    margin-top: var(--home-gap);
    color: var(--muted);
  }

  /* One enclosing canvas keeps the chat and its six items visibly related. */
  .luggage-map {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 1.25fr) minmax(0, 1fr);
    grid-template-rows: repeat(3, minmax(80px, auto));
    gap: 16px var(--home-gap);
    padding: var(--home-card-padding);
    border: 1px solid var(--line);
    border-radius: var(--home-radius);
    background: var(--surface);
  }

  .luggage-threads {
    position: absolute;
    inset: var(--home-card-padding);
    width: calc(100% - var(--home-card-padding) - var(--home-card-padding));
    height: calc(100% - var(--home-card-padding) - var(--home-card-padding));
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 4 6;
    opacity: 0.5;
    pointer-events: none;
  }

  .luggage-items {
    display: contents;
  }

  .story-window {
    position: relative;
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: center;
    border: 1px solid var(--accent);
    border-radius: var(--home-radius);
    background: var(--bg);
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .window-dots {
    display: flex;
    gap: 5px;
  }

  .window-dots i {
    width: 5px;
    height: 5px;
    border: 1px solid var(--accent);
    border-radius: 50%;
  }

  .window-content {
    padding: 24px 16px;
    text-align: center;
  }

  .window-content p {
    margin-top: 8px;
    color: var(--muted);
  }

  .window-foot {
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    color: var(--accent);
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
  }

  .luggage-item {
    position: relative;
